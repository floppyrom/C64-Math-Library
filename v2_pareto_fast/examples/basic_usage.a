; v2 Pareto-Fast: initialize once, then use the same public vectors as v1.
!source "../resident/math_api.inc"
        jsr MATH_INIT
        lda #$34 : sta math_x0
        lda #$12 : sta math_x1
        lda #$20 : sta math_y0
        lda #0   : sta math_y1
        jsr MATH_UMUL16       ; z0..z3 = $00024680, C=0

        jsr MATH_UDIV16       ; n/d -> q,r
        bcs .divide_by_zero
.divide_by_zero:
