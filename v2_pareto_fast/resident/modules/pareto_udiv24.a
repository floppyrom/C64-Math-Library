; ============================================================================
; Pareto-Fast profile module — UDIV24 Size-Fast 1,191 B
; ============================================================================
; This is the size-aware fast selection used by C64 Math API v1-PF.
; Selected over 14,885 B Extreme: ~7.17 native cycles slower while saving ~13.7 KiB.
; Public adaptation is outside the measured native kernel unless noted.
; Decimal mode must be clear. A/X/Y are volatile.
; ============================================================================
;ABI
;CPU: mos6502
;Operation: udiv
;Entry: div_u24
;Input n: uint24 = n0, n1, n2
;Input d: uint24 = d0, d1, d2
;Output q: uint24 = q0, q1, q2
;Remainder r: uint24 = r0, r1, r2
;UDiv zero remainder: zero
;Region ZP: cg_zp_start..cg_zp_end
;Region Code: cg_code_start..cg_code_end
;End ABI
; ============================================================================
; FIREMONGER C64 DIVISION REFERENCE — PUBLICATION COPY
; Family       : udiv24
; Tier         : size-fast
; Target       : NMOS 6502/6510, decimal mode clear
; Measurement  : canonical 2,097,152-case SplitMix64 corpus; seed $C0FFEE where random
; Timing       : entry instruction through final RTS; caller JSR excluded
; Avg cycles   : 107.612991
; Min / Max    : 41 / 2298
; Stddev       : 146.080937
; Resident     : 1191 bytes (Code 1191 + Data 0); ZP 15 bytes separate
; Validation   : 2097152 cases, 0 errors
; Edge suite   : 5578 cases in canonical run, 0 errors
; Architecture : Deferred divisor-zero test, live high residual byte, fully unrolled high-d2 quotient states; T=13.
;
; NOTE: this publication block is comments only and does not alter the exact
; assembled image that produced the result. Raw canonical JSON is supplied
; beside the source when available. See TECHNICAL_ASSESSMENT.md for caveats.
; ============================================================================
!cpu 6502
*=$10
cg_zp_start:
n0: !byte 0
n1: !byte 0
n2: !byte 0
d0: !byte 0
d1: !byte 0
d2: !byte 0
q0: !byte 0
q1: !byte 0
q2: !byte 0
r0: !byte 0
r1: !byte 0
r2: !byte 0
sd0: !byte 0
sd1: !byte 0
sd2: !byte 0
cg_zp_end:
*=$4800
cg_code_start:
zero:
 lda #0
 ldx #5
zero_loop:
 sta q0,x
 dex
 bpl zero_loop
 sec
 rts
div_u24:
 !byte $a7,n2
 cmp d2
 bcc qzero
 beq high_equal
 lda d2
 beq low_d2
 jmp high_gt
high_equal:
 lda d2
 beq low_d2_equal
 lda n1
 cmp d1
 bcc qzero
 bne equal_ge
 lda n0
 cmp d0
 bcc qzero
equal_ge:
 lda n0
 sbc d0
 sta r0
 lda n1
 sbc d1
 sta r1
 lda n2
 sbc d2
 sta r2
 !byte $0b,$00
 sta q1
 sta q2
 lda #1
 sta q0
 rts
low_d2_equal:
 lda d0
 ora d1
 beq zero
 lda n1
 cmp d1
 bcc qzero
 bne low_tail0
 lda n0
 cmp d0
 bcc qzero
 bcs low_tail0
low_d2:
 lda d0
 ora d1
 beq zero
low_tail0:
 lda n0
 sta r0
 lda n1
 sta r1
 lda n2
 sta r2
 lda #0
 sta tail_bias+1
 jmp tail_setup
qzero:
 lda #0
 sta q0
 sta q1
 sta q2
 lda n0
 sta r0
 lda n1
 sta r1
 stx r2
 rts
high_gt:
 lda n0
