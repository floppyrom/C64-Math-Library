; ============================================================================
; Pareto-Fast profile module — UMOD8 Size-Fast 114 B
; ============================================================================
; This is the size-aware fast selection used by C64 Math API v1-PF.
; Chosen instead of Table16: 34.819 cycles native, no 3.25 KiB table bank and no $0300-$0FFF reservation.
; Public adaptation is outside the measured native kernel unless noted.
; Decimal mode must be clear. A/X/Y are volatile.
; ============================================================================
; Unsigned 8-bit modulo, speculative chain through attempt 16.
; Generated by gen_umod8_chain.py. n,d preserved; A=remainder.
; C=0 success; A=0/C=1 when d=0. Final RTS included.
;ABI
;CPU: mos6502
;Operation: umod
;Entry: umod8
;Input n: uint8 = n
;Input d: uint8 = d
;Output r: uint8 = reg:A
;Region ZP: cg_zp_start..cg_zp_end
;Region Code: cg_code_start..cg_code_end
;End ABI
;Results
;Status: validated
;Validation level: validate
;Validation cases: 65536
;Validation errors: 0
;Validation complete: yes
;Edge cases: 603
;Edge errors: 0
;Edge complete: yes
;Profile distribution: uniform
;Profile cases: 65536
;Profile errors: 0
;Profile complete: yes
;Min cycles: 21
;Max cycles: 465
;Avg cycles: 34.819153
;Stddev cycles: 30.266575
;ZP bytes: 2
;Code bytes: 114
;Data bytes: 0
;Total bytes: 114
;End Results
!cpu 6502
*=$10
cg_zp_start:
n: !byte 0
d: !byte 0
cg_zp_end:
*=$5200
cg_code_start:
divisor_small:
        cpx #1
        bcc divisor_zero
        beq divisor_one
        and #1                    ; d=2
        clc
        rts
divisor_one:
        lda #0
        clc
        rts
divisor_zero:
        lda #0
        sec
        rts
umod8:
        lda n
        ldx d
umod8_ax:
        cpx #3
        bcc divisor_small
        cmp d
        bcs q_at_least_1
        rts
q_at_least_1:
        sbc d
        cmp d
        bcs q_at_least_2
        rts
q_at_least_2:
        sbc d                 ; guaranteed attempt 2
        sbc d                 ; attempt 3
        bcc restore
        sbc d                 ; attempt 4
        bcc restore
        sbc d                 ; attempt 5
        bcc restore
        sbc d                 ; attempt 6
        bcc restore
        sbc d                 ; attempt 7
        bcc restore
        sbc d                 ; attempt 8
        bcc restore
        sbc d                 ; attempt 9
        bcc restore
        sbc d                 ; attempt 10
        bcc restore
        sbc d                 ; attempt 11
        bcc restore
        sbc d                 ; attempt 12
        bcc restore
        sbc d                 ; attempt 13
        bcc restore
        sbc d                 ; attempt 14
        bcc restore
        sbc d                 ; attempt 15
        bcc restore
        sbc d                 ; attempt 16
        bcc restore
        ; Surviving the chain is extremely cold. Immediate SMC repays its
        ; normal-RAM setup on the large quotients that can reach this point.
        stx tail_subtract+1
        stx tail_restore+1
tail_subtract:
        sbc #0
        bcs tail_subtract
tail_restore:
        adc #0
        clc
        rts
restore:
        adc d
        clc
        rts
cg_code_end:
