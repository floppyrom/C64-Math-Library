; Basic use of the composable public ABI.
!source "../resident/math_api.inc"

; 16-bit product: $1234 * $0020 -> math_z0..math_z3
        lda #$34
        sta math_x0
        lda #$12
        sta math_x1
        lda #$20
        sta math_y0
        lda #$00
        sta math_y1
        jsr MATH_UMUL16            ; C=0, inputs preserved

; 24-bit divide: n/d -> q,r. Always test carry if d may be zero.
        jsr MATH_UDIV24
        bcs divide_by_zero
        ; math_q0..q2 and math_r0..r2 are valid here.
divide_by_zero:
