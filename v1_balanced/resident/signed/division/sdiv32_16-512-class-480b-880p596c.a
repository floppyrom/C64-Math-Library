;ABI
;CPU: mos6502
;Operation: sdiv
;Entry: div_s32_16
;Input n: int32 = sn0, sn1, sn2, sn3
;Input d: int16 = sdi0, sdi1
;Output q: int32 = lq0, lq1, q0, q1
;Remainder r: int16 = r0, r1
;Region ZP: sg_zp_start..sg_zp_end, cg_zp_start..cg_zp_end, mx_zp_start..mx_zp_end
;Region Code: sg_code_start..sg_code_end, mx_code_start..mx_code_end, cg_code_start..cg_code_end
;End ABI
; ============================================================================
; FIREMONGER C64 DIVISION REFERENCE — PUBLICATION COPY
; Family       : sdiv32_16
; Tier         : 512-class
; Target       : NMOS 6502/6510, decimal mode clear
; Measurement  : canonical 2,097,152-case SplitMix64 corpus; seed $C0FFEE where random
; Timing       : entry instruction through final RTS; caller JSR excluded
; Avg cycles   : 880.596406
; Min / Max    : 110 / 1875
; Stddev       : 168.868764
; Resident     : 480 bytes (Code 480 + Data 0); ZP 18 bytes separate
; Validation   : 2097152 cases, 0 errors
; Edge suite   : 18545 cases in canonical run, 0 errors
; Architecture : Sub-512-byte signed mixed-width routine with direct-launch high-word strategy.
;
; NOTE: this publication block is comments only and does not alter the exact
; assembled image that produced the result. Raw canonical JSON is supplied
; beside the source when available. See TECHNICAL_ASSESSMENT.md for caveats.
; ============================================================================
!cpu 6502

; ============================================================================
; DIV_U16 / 128-BYTE CLASS — DIRECT-LAUNCH RECORD
; Fast unsigned 16/16 division for NMOS 6502/6510
;
; Hard target:
;       executable code <= 128 bytes
;
; Final source:
;       executable code = 124 bytes ($1000-$107b)
;       ZP ABI           =   8 bytes ($10-$17)
;       tables           =   0 bytes
;
; ABI:
;       n1:n0  unsigned 16-bit dividend       (preserved)
;       d1:d0  unsigned 16-bit divisor        (preserved)
;       q1:q0  unsigned 16-bit quotient
;       r1:r0  unsigned 16-bit remainder
;       C=0    success
;       C=1    divide by zero, q=r=0
;
;       A/X/Y clobbered.
;       Decimal mode MUST be clear on entry (D=0).
;
; CPU note:
;       Uses stable NMOS undocumented LAX zp ($a7).  Intended for NMOS
;       6502/6510 machines such as the C64; not a portable CMOS-65C02 routine.
;
; Design summary
; --------------
; Uniform unsigned 16/16 division is heavily biased toward tiny quotients.
; We therefore choose between two algorithms from only the divisor high byte:
;
;   * d1 >= 5:
;         repeated 16-bit subtraction.  Since d >= 5*256, q <= 51.
;
;   * d1 = 0..4:
;         fixed 16-step restoring division, avoiding a long subtraction tail.
;
; Three data-flow details are important for the byte/cycle result:
;
;   1. LAX n1 keeps the original high dividend simultaneously in A and X.
;      X survives every dispatch path that reaches long_setup, so q1 can be
;      initialized with STX q1 rather than reloading n1.
;
;   2. The compare at the bottom of the subtraction chain supplies C=1 for
;      the next SBC.  SEC is therefore not needed inside the hot loop.
;
;   3. The first subtraction consumes n1:n0 directly.  It neither copies the
;      dividend into r1:r0 nor reloads r0 before doing useful arithmetic.
;      The common successful result falls into the same commit block used by
;      every later iteration.
;
; At origin $1000 the whole 124-byte image lies within one page, so no taken
; relative branch can incur a page-cross penalty.
;
; Validation in the included instruction-level NMOS model:
;   - 576 structured edge pairs: 0 errors, inputs preserved
;   - 1,000,000 random pairs, seed $C0FFEE: 92.009095 average
;   - 5,000,000 random pairs, seed $C0FFEE: 92.074484 average
;   - RTS included; caller JSR excluded; min/max on 1M: 32 / 1532
; ============================================================================

; ---- zero-page ABI ----------------------------------------------------------
* = $0010
cg_zp_start:
n0:     !byte 0
n1:     !byte 0
d0:     !byte 0
d1:     !byte 0
q0:     !byte 0
q1:     !byte 0
r0:     !byte 0
r1:     !byte 0
cg_zp_end:

; ---- code -------------------------------------------------------------------
* = $1000
cg_code_start:

div_u16
        ; A=X=n1.  The initial high-byte compare resolves most q=0 cases
        ; without touching the low bytes.
        !byte $a7,n1              ; LAX n1
        cmp d1
        bcc qzero_fast            ; n1<d1 => n<d => q=0

        ; Select repeated subtraction only where its worst quotient is small.
        lda d1
        beq low_d1_zero           ; d1=0: divide-by-zero check or binary tail
        cmp #5
        bcc long_setup            ; d1=1..4 -> restoring divider

subtract_setup
        ; Directly launch the first subtraction from the preserved input.  This
        ; is the division analogue of the multiply core's first-row launch:
        ; no copy to r1:r0 and no reload of r0 before useful work begins.
        ; C=1 here because CMP #5 was >=.
        lda n0
        sbc d0
        tay
        txa                       ; X still contains original n1
        sbc d1
        bcc qzero_fast            ; equal high byte but n0<d0
        ldx #0

subtract_commit
        sta r1
        sty r0
        inx
        cmp d1
        bcc subtract_done

subtract_loop
        ; Trial r -= d.  Low result is held in Y until high subtraction proves
        ; the 16-bit subtraction succeeded, so a failed trial leaves r intact.
        lda r0
        sbc d0
        tay
        lda r1
        sbc d1
        bcs subtract_commit       ; success commits; failure falls through

subtract_done
        stx q0                    ; quotient is <=51 on this path
        lda #0
        sta q1
        rts                       ; C=0: failed subtraction/compare left clear

low_d1_zero
        ; d1=0.  d0=0 is the only divide-by-zero case; otherwise use the full
        ; restoring divider.  X still holds n1 for long_setup.
        lda d0
        bne long_setup

div_zero
        ; A is already zero because d0=0.
        ldx #3
zero_clear
        sta q0,x                  ; clears q0,q1,r0,r1
        dex
        bpl zero_clear
        sec
        rts

long_setup
        ; Classic 16-step restoring divide.  q starts as the dividend and is
        ; shifted left; r accumulates the partial remainder.  Each successful
        ; trial subtraction sets the newly generated quotient bit with INC q0.
        lda n0
        sta q0
        stx q1                    ; X is original n1 from entry LAX
        lda #0
        sta r0
        sta r1
        ldx #16

long_loop
        asl q0
        rol q1
        rol r0
        rol r1

        sec
        lda r0
        sbc d0
        tay
        lda r1
        sbc d1
        bcc long_no_sub
        sta r1
        sty r0
        inc q0                    ; low bit is known zero immediately after ASL

long_no_sub
        dex
        bne long_loop
        clc
        rts

qzero_fast
        ; X still contains n1 from LAX.  Inputs are preserved.
        stx r1
        lda n0
        sta r0
        lda #0
        sta q0
        sta q1
        rts                       ; CMP left C=0
cg_code_end:



*=$0018
mx_zp_start:
ln0: !byte 0
ln1: !byte 0
lq0: !byte 0
lq1: !byte 0
mx_zp_end:
*=$5000
mx_code_start:
div_u32_16:
        jsr div_u16
        bcc mx_nz
        lda #0
        sta lq0
        sta lq1
        rts
mx_nz:
        lda ln0
        sta lq0
        lda ln1
        sta lq1
        lda r1
mx_p0:
        rol lq0
        rol lq1
        rol r0
        rol
        bcs mx_pf0
        cmp d1
        bcc mx_pn0
        bne mx_pt0
        ldy r0
        cpy d0
        bcc mx_pn0
mx_pt0:
        tay
        lda r0
        sbc d0
        sta r0
        tya
        sbc d1
        bcs mx_pn0
mx_pf0:
        tay
        lda r0
        sbc d0
        sta r0
        tya
        sbc d1
        sec
mx_pn0:
        ldx #15
mx_loop:
        rol lq0
        rol lq1
        rol r0
        rol
        bcs mx_force
        cmp d1
        bcc mx_no
        bne mx_take
        ldy r0
        cpy d0
        bcc mx_no
mx_take:
        tay
        lda r0
        sbc d0
        sta r0
        tya
        sbc d1
        bcs mx_no
mx_force:
        tay
        lda r0
        sbc d0
        sta r0
        tya
        sbc d1
        sec
mx_no:
        dex
        bne mx_loop
        rol lq0
        rol lq1
        sta r1
        clc
        rts
mx_code_end:


*=$00e0
sg_zp_start:
sn0: !byte 0
sn1: !byte 0
sn2: !byte 0
sn3: !byte 0
sdi0: !byte 0
sdi1: !byte 0
sg_zp_end:
*=$7000
sg_code_start:
div_s32_16:
        ; Classify divisor sign.  d=0 is detected while sd1 is already live;
        ; the unsigned zero handler can be tail-called without forming |n|.
        lda sdi1
        bmi s_dneg
        bne s_dpos_hi
        lda sdi0
        bne s_dpos_low
        jmp s_zero
s_dpos_low:
        sta d0
        lda #0
        sta d1
        jmp s_n_for_dpos
s_dpos_hi:
        sta d1
        lda sdi0
        sta d0
s_n_for_dpos:
        lda sn3
        bmi s_np_setup
        ; PP: positive numerator / positive divisor.
s_pp_setup:
        lda sn0
        sta ln0
        lda sn1
        sta ln1
        lda sn2
        sta n0
        lda sn3
        sta n1
        jsr div_u32_16
        ; d!=0 was proved and unsigned success guarantees C=0.
        rts

s_np_setup:
        ; NP: negative numerator / positive divisor.  Both q and r are negative.
        lda #0
        sec
        sbc sn0
        sta ln0
        lda #0
        sbc sn1
        sta ln1
        lda #0
        sbc sn2
        sta n0
        lda #0
        sbc sn3
        sta n1
        jsr div_u32_16
        ; negate remainder
        lda #0
        sec
        sbc r0
        sta r0
        lda #0
        sbc r1
        sta r1
        ; negate quotient
        lda #0
        sec
        sbc lq0
        sta lq0
        lda #0
        sbc lq1
        sta lq1
        lda #0
        sbc q0
        sta q0
        lda #0
        sbc q1
        sta q1
        clc
        rts

s_dneg:
        ; |d|.  A negative int16 divisor is necessarily nonzero.
        lda #0
        sec
        sbc sdi0
        sta d0
        lda #0
        sbc sdi1
        sta d1
        lda sn3
        bmi s_nn_setup
        ; PN: positive numerator / negative divisor => negative quotient only.
s_pn_setup:
        lda sn0
        sta ln0
        lda sn1
        sta ln1
        lda sn2
        sta n0
        lda sn3
        sta n1
        jsr div_u32_16
        lda #0
        sec
        sbc lq0
        sta lq0
        lda #0
        sbc lq1
        sta lq1
        lda #0
        sbc q0
        sta q0
        lda #0
        sbc q1
        sta q1
        clc
        rts

s_nn_setup:
        ; NN: quotient positive, remainder negative.
        lda #0
        sec
        sbc sn0
        sta ln0
        lda #0
        sbc sn1
        sta ln1
        lda #0
        sbc sn2
        sta n0
        lda #0
        sbc sn3
        sta n1
        jsr div_u32_16
        lda #0
        sec
        sbc r0
        sta r0
        lda #0
        sbc r1
        sta r1
        clc
        rts

s_zero:
        ; sd0=sd1=0 and A=0.  Feed that proven zero divisor to the unsigned
        ; handler; numerator magnitude is irrelevant on this path.
        sta d0
        sta d1
        jmp div_u32_16
sg_code_end:
