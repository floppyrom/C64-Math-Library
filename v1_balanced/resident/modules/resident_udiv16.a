;ABI
;CPU: mos6502
;Operation: udiv
;Entry: div_u16
;Input n: uint16 = n0, n1
;Input d: uint16 = d0, d1
;Output q: uint16 = q0, q1
;Remainder r: uint16 = r0, r1
;UDiv zero remainder: zero
;Region ZP: cg_zp_start..cg_zp_end
;Region Code: cg_code_start..cg_code_end
;End ABI
