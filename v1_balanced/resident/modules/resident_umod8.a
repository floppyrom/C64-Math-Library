!cpu 6502
n=$10
d=$11

*=$4600
cg_code_start:
divisor_small:
        cpx #1
        bcc divisor_zero
        beq divisor_one
        and #1                    ; d=2
        clc
        rts
divisor_one:
        lda #0
        clc
        rts
divisor_zero:
        lda #0
        sec
        rts
umod8:
        lda n
        ldx d
umod8_ax:
        cpx #3
        bcc divisor_small
        cmp d
        bcs q_at_least_1
        rts
q_at_least_1:
        sbc d
        cmp d
        bcs q_at_least_2
        rts
q_at_least_2:
        sbc d                 ; guaranteed attempt 2
        sbc d                 ; attempt 3
        bcc restore
        sbc d                 ; attempt 4
        bcc restore
        ; Surviving the chain is extremely cold. Immediate SMC repays its
        ; normal-RAM setup on the large quotients that can reach this point.
        stx tail_subtract+1
        stx tail_restore+1
tail_subtract:
        sbc #0
        bcs tail_subtract
tail_restore:
        adc #0
        clc
        rts
restore:
        adc d
        clc
        rts
cg_code_end:
