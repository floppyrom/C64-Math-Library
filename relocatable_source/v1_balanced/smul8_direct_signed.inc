; Direct signed-domain SMUL8: Q(a+b)-Q(a-b), exhaustive 65,536-case qualified.
; 46-byte public kernel, 0 ZP, 0 persistent stack-page bytes.
; Private signed-sum planes use the common reserved $9C00/$9E00 pages.
; Complemented difference planes are shared with the profile's quarter-square tables.
!cpu 6510
SMUL8_SUM_LO = $9C00
SMUL8_SUM_HI = $9E00
SMUL8_NEG_LO = REG_TABLE+$2800
SMUL8_NEG_HI = REG_TABLE+$2A00

* = MATH_SMUL8
SMUL8_direct:
        lda MATH_IO+$00
        eor #$80
        sta SMUL8_s1+1
        sta SMUL8_s3+1
        eor #$ff
        sta SMUL8_s2+1
        sta SMUL8_s4+1
        lda MATH_IO+$04
        eor #$80
        tax
        sec
SMUL8_s1:
        lda SMUL8_SUM_LO,x
SMUL8_s2:
        adc SMUL8_NEG_LO,x
        sta MATH_IO+$08
SMUL8_s3:
        lda SMUL8_SUM_HI,x
SMUL8_s4:
        adc SMUL8_NEG_HI,x
        sta MATH_IO+$09
        clc
        rts

