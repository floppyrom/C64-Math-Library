; ============================================================================
; V3 REU 512K resident module — ATAN2 sum-fast
; ============================================================================
; Stable public entry: MATH_ATAN2_8 = $5E2A
; Inputs: X0=signed x, Y0=signed y; output: Z0=phase8
; Accuracy: exhaustive 65,536-vector validation, max error <= 1 phase unit
; Public-entry timing: 44.962814 mean cycles, range 29-47
; Normal ZP: 0 bytes
; Installed body: $C78D-$C7E5
; Tables: LOGX=$9600, LOGY=$9700, QPOS=$6E00, QNEG=$6F00
; Canonical reusable source: routines/atan2/atan2_sum_fast.asm
; ============================================================================

!cpu 6502

X0=$C000
Y0=$C004
Z0=$C008
LOGX=$9600
LOGY=$9700
QPOS=$6E00
QNEG=$6F00
*=$C78D
atan2:
    ldx X0
    beq axis
    bmi xneg
    lda LOGX,x
    ldx Y0
    bmi xpyn
    clc
    adc LOGY,x
    tax
    lda QPOS,x
    sta Z0
    rts
xpyn:
    clc
    adc LOGY,x
    tax
    lda QNEG,x
    sta Z0
    rts
xneg:
    lda LOGX,x
    ldx Y0
    bmi xnyn
    clc
    adc LOGY,x
    tax
    lda QNEG,x
    eor #$80
    sta Z0
    rts
xnyn:
    clc
    adc LOGY,x
    tax
    lda QPOS,x
    eor #$80
    sta Z0
    rts
axis:
    clc
    lda Y0
    beq axis_store
    asl
    lda #$80
    ror
axis_store:
    sta Z0
    rts
