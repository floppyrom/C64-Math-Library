 rts
cont0:
 sbc md
 cmp md
 bcs cont1
 sta r
 lda #1
 sta q
 bit n
 bmi q1_nneg
 bit d
 bmi q1_negpos
 clc
 rts
q1_negpos:
 lda #$ff
 sta q
