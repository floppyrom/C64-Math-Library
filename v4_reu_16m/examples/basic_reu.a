; Basic Firemonger C64 Math API v3 REU example.
; Load the matching 512 KiB .reu image before running the program.
; Public symbols/addresses are declared by math_api.inc.
!source "../resident/math_api.inc"

* = $2000

        jsr MATH_INIT          ; required once after REU image is installed

        lda #$34              ; X=$1234
        sta math_x0
        lda #$12
        sta math_x1
        lda #$78              ; Y=$0078
        sta math_y0
        lda #$00
        sta math_y1
        jsr MATH_UMUL16       ; Z=$0008:8860, C=0

        ; The same public vectors can be reused for another primitive.
        ; See MATH_API.md for each width and result layout.
        rts
